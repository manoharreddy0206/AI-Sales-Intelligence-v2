# Copy to .env (git-ignored) or set these in your host's dashboard.
# All variables are read by the backend only; the browser never sees them.

# SQLite file. Defaults to backend/sales.db locally and /data/sales.db in Docker.
SALES_DB=

# 1 = public demo: seed backend/sample_sales.csv into an empty database and disable uploads.
DEMO_MODE=0

# Copilot provider: "anthropic" (real tool calling) or "stub" (rule-based, no LLM, labelled in the UI).
# Left empty: anthropic when ANTHROPIC_API_KEY is set, otherwise stub.
COPILOT_PROVIDER=
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-haiku-5-5
COPILOT_TIMEOUT_SECONDS=20
COPILOT_DEADLINE_SECONDS=30
COPILOT_RATE_LIMIT_PER_10_MIN=30

# Comma-separated origins allowed to call the API from another host (not needed for the single-service image).
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
